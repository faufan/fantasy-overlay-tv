                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tm6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#9AA4B2"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tp6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="#F3F5F8"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="0dp"
                android:layout_weight="1"
                android:background="@drawable/widget_tile"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="9dp"
                android:paddingTop="6dp"
                android:paddingRight="9dp"
                android:paddingBottom="6dp"
                android:visibility="invisible">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tn7"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#F3F5F8"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tm7"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#9AA4B2"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tp7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="#F3F5F8"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/liveNone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_horizontal"
            android:text="No one playing"
            android:textColor="#D3D9E1"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/liveThem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:text=""
            android:textColor="#FFB57A"
            android:textSize="11sp" />
    </LinearLayout>

    <include layout="@layout/widget_part_modes" />
</LinearLayout>
